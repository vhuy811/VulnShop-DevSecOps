# Ban DA GIA CO - sua dung 3 van de ma Trivy chi ra o Dockerfile ngay tho.
#
#   1. Build nhieu giai doan: image cuoi dung `aspnet` (chi co runtime) thay vi
#      `sdk`. Bo di trinh bien dich, NuGet, git... nen giam manh so goi he dieu
#      hanh, keo theo giam so CVE.
#   2. Tao nguoi dung thuong va chuyen sang dung no. Neu ke tan cong thoat ra
#      duoc khoi ung dung, ho khong co quyen root trong container.
#   3. Co HEALTHCHECK de he thong dieu phoi biet container con song hay khong.
#
# So sanh so CVE giua hai ban bang: python tools/trivy.py --compare

# ---------- Giai doan build ----------
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

# Chep rieng csproj truoc de tan dung cache khi ma nguon doi ma phu thuoc khong doi
COPY *.csproj ./
RUN dotnet restore

COPY . .
RUN dotnet publish -c Release -o /out --no-restore

# ---------- Giai doan chay ----------
FROM mcr.microsoft.com/dotnet/aspnet:9.0
WORKDIR /app
COPY --from=build /out .

# Khong chay bang root
RUN adduser --disabled-password --gecos "" --uid 10001 appuser \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE 5000
ENV ASPNETCORE_URLS=http://0.0.0.0:5000 \
    DOTNET_EnableDiagnostics=0

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD ["dotnet", "--info"]

ENTRYPOINT ["dotnet", "VulnShop.dll"]
