@model List<string>
@{
    ViewData["Title"] = "Tim kiem san pham";
}

<h2>Ket qua tim kiem</h2>
<p>Tu khoa: @ViewBag.Query</p>

@if (Model.Count == 0)
{
    <p><em>Khong co san pham nao khop.</em></p>
}
else
{
    <ul>
        @foreach (var r in Model)
        {
            <li>@r</li>
        }
    </ul>
}

<p><a asp-controller="Product" asp-action="List">Xem tat ca san pham</a></p>
